NEXT_PUBLIC_SITE_URL=https://lomas-ai.vercel.app

# Storage: mock, firebase, mongodb, none
NEXT_PUBLIC_ENQUIRY_STORAGE_PROVIDER=firebase

# Email: smtp, none
NEXT_PUBLIC_ENQUIRY_EMAIL_PROVIDER=smtp

# Legacy fallback. Prefer NEXT_PUBLIC_ENQUIRY_STORAGE_PROVIDER.
NEXT_PUBLIC_ENQUIRY_PROVIDER=none

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin SDK credentials for /api/admin/config saves.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

MONGODB_URI=
MONGODB_DB_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFICATION_TO=

# Recommended for Firebase admin auth: comma-separated allowlist
ADMIN_FIREBASE_EMAILS=
