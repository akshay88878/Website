NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

MONGODB_URI=
MONGODB_DB_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFICATION_TO=

# Recommended for Firebase admin auth: comma-separated allowlist
ADMIN_FIREBASE_EMAILS=
